# ==========================================
# Application
# ==========================================
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080

# ==========================================
# Database (Main)
# ==========================================
DB_HOST=localhost
DB_PORT=5435
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_db
DATABASE_URL=postgres://postgres:postgres@localhost:5435/app_db?sslmode=disable
MIGRATE_DATABASE_URL=
# Optional. When set, the migrate subcommand uses this URL.
# Falls back to DATABASE_URL. Use a role with DDL privileges
# (migrate_user in production, not a superuser) when the runtime
# DATABASE_URL uses a limited role.

# ==========================================
# Database (Test)
# ==========================================
TEST_DB_PORT=5436
TEST_DB_NAME=app_test

# ==========================================
# PgAdmin
# ==========================================
PGADMIN_PORT=5051
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# ==========================================
# Sign-in (JWT)
# ==========================================
# Required by the server (not by `api migrate`), at least 32 bytes.
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=amgreports
JWT_AUDIENCE=amgreports-web
# Access token life; refresh token absolute life and idle limit. Seconds or a Go duration.
JWT_ACCESS_TTL=10m
REFRESH_TTL=24h
REFRESH_IDLE_TTL=30m
# Leave empty for host-only cookies; D-F1 sets .amgreports.com.
COOKIE_DOMAIN=

# ==========================================
# Initial admin user (optional)
# ==========================================
# Seeded on startup only when BOTH are set. Password min 12 chars.
# Use a strong, unique password; never reuse it across environments.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ==========================================
# Logging
# ==========================================
# Levels: debug, info, warn, error
# Formats: text, json
LOG_LEVEL=debug
LOG_FORMAT=text

# ==========================================
# API surface (Swagger UI and /metrics)
# ==========================================
# SWAGGER_ENABLED: serve /swagger/*. Unset: on outside production, off in
# production. SWAGGER_ENABLED=true in production exposes the Swagger UI publicly
# (no auth). Use only for temporary/internal access.
# SWAGGER_ENABLED=true
#
# METRICS_USER / METRICS_PASSWORD: Basic Auth for /metrics. Set both or neither;
# the password needs at least 12 characters. When set, /metrics always
# requires them. When unset, /metrics is open outside production and not
# served in production.
# METRICS_USER=
# METRICS_PASSWORD=

# ==========================================
# Trusted proxies
# ==========================================
# Comma-separated CIDRs of the proxies whose X-Real-IP is believed. Only these
# peers are trusted; loopback and private ranges are not unless listed.
# Required with APP_ENV=production: the server refuses to start when it is
# unset or contains a /0 range (0.0.0.0/0, ::/0). Render uses 100.64.0.0/10.
# Outside production, unset uses 0.0.0.0/0 and logs a warning; locally there is
# no proxy, so the peer's own address is used either way.
# TRUSTED_PROXY_CIDRS=100.64.0.0/10

# ==========================================
# Reports rate limit
# ==========================================
# One shared per-user bucket for the reports write routes (POST, PUT, DELETE,
# PATCH): the four routes share it, users do not. Reads and the global per-IP limit have fixed values (cmd/api/main.go). RATE is requests per minute. Both must be
# positive integers; the defaults are 60 per minute with a burst of 10.
# REPORTS_WRITE_RATE_LIMIT=60
# REPORTS_WRITE_BURST=10

# ==========================================
# CORS
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ==========================================
# Connection pool (managed Postgres such as Neon)
# ==========================================
# Use the DIRECT endpoint (no "-pooler" in the host) with sslmode=require. A pooled
# endpoint runs PgBouncer in transaction mode and breaks prepared statements; if you
# must use it, add default_query_exec_mode=simple_protocol to DATABASE_URL.
# Unset DB_MIN_CONNS for none; the others take seconds or a Go duration.
DB_MAX_CONNS=20
# DB_MIN_CONNS=
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=30m

# ==========================================
# Sentry (optional)
# ==========================================
# Empty leaves error reporting off. Read before this file loads, so set it
# in the real environment (Render, or the shell), not here.
SENTRY_DSN=
