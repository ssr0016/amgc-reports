# ==========================================
# Application
# ==========================================
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080

# ==========================================
# Database (Main)
# ==========================================
DB_HOST=localhost
DB_PORT=5435
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_db
DATABASE_URL=postgres://postgres:postgres@localhost:5435/app_db?sslmode=disable

# ==========================================
# Database (Test)
# ==========================================
TEST_DB_PORT=5436
TEST_DB_NAME=app_test
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5436/app_test?sslmode=disable

# ==========================================
# PgAdmin
# ==========================================
PGADMIN_PORT=5051
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# ==========================================
# Session
# ==========================================
# Generate with: openssl rand -hex 32
SESSION_COOKIE_NAME=app_session
SESSION_LIFETIME=86400
SESSION_IDLE_TIMEOUT=1800

# ==========================================
# Logging
# ==========================================
# Levels: debug, info, warn, error
# Formats: text, json
LOG_LEVEL=debug
LOG_FORMAT=text

# ==========================================
# CORS
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000
