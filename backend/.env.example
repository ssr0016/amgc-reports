# ==========================================
# Application
# ==========================================
APP_ENV=development
APP_PORT=8080
APP_URL=http://localhost:8080

# ==========================================
# Database (Main)
# ==========================================
DB_HOST=localhost
DB_PORT=5435
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app_db
DATABASE_URL=postgres://postgres:postgres@localhost:5435/app_db?sslmode=disable
MIGRATE_DATABASE_URL=
# Optional. When set, the migrate subcommand uses this URL.
# Falls back to DATABASE_URL. Use a role with DDL privileges
# (migrate_user in production, not a superuser) when the runtime
# DATABASE_URL uses a limited role.

# ==========================================
# Database (Test)
# ==========================================
TEST_DB_PORT=5436
TEST_DB_NAME=app_test

# ==========================================
# PgAdmin
# ==========================================
PGADMIN_PORT=5051
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# ==========================================
# Session
# ==========================================
# Generate with: openssl rand -hex 32
SESSION_COOKIE_NAME=app_session
SESSION_LIFETIME=86400
SESSION_IDLE_TIMEOUT=1800

# ==========================================
# Initial admin user (optional)
# ==========================================
# Seeded on startup only when BOTH are set. Password min 12 chars.
# Use a strong, unique password; never reuse it across environments.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ==========================================
# Logging
# ==========================================
# Levels: debug, info, warn, error
# Formats: text, json
LOG_LEVEL=debug
LOG_FORMAT=text

# ==========================================
# API surface (Swagger UI and /metrics)
# ==========================================
# SWAGGER_ENABLED: serve /swagger/*. Unset: on outside production, off in
# production. SWAGGER_ENABLED=true in production exposes the Swagger UI publicly
# (no auth). Use only for temporary/internal access.
# SWAGGER_ENABLED=true
#
# METRICS_USER / METRICS_PASSWORD: Basic Auth for /metrics. Set both or neither;
# the password needs at least 12 characters. When set, /metrics always
# requires them. When unset, /metrics is open outside production and not
# served in production.
# METRICS_USER=
# METRICS_PASSWORD=

# ==========================================
# Trusted proxies
# ==========================================
# Comma-separated CIDRs of the proxies whose X-Real-IP is believed. Only these
# peers are trusted; loopback and private ranges are not unless listed.
# Unset uses 100.64.0.0/10 (Railway's edge) and logs a warning. Locally there is
# no proxy, so the peer's own address is used either way.
# TRUSTED_PROXY_CIDRS=100.64.0.0/10

# ==========================================
# Reports rate limit
# ==========================================
# One shared per-user bucket for the reports write routes (POST, PUT, DELETE,
# PATCH): the four routes share it, users do not. Reads and the global per-IP limit have fixed values (cmd/api/main.go). RATE is requests per minute. Both must be
# positive integers; the defaults are 60 per minute with a burst of 10.
# REPORTS_WRITE_RATE_LIMIT=60
# REPORTS_WRITE_BURST=10

# ==========================================
# CORS
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000
